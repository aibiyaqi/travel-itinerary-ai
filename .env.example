# ============================================
# AI旅行智能助手 — 环境变量模板
# 复制此文件为 .env 并填入真实值
# ============================================

# ====== 通义千问 API 配置（必填） ======
# 获取方式：登录阿里云 DashScope 控制台 → API-Key 管理 → 创建 API-Key
# 地址：https://dashscope.aliyuncs.com/
QWEN_API_KEY=sk-your-api-key-here

# ====== 管理员账号（首次启动自动创建，必填） ======
# 未配置 ADMIN_PASSWORD 时不会创建管理员，请务必设置强密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为至少8位的强密码

# ====== 注册策略 ======
# B 端内部系统默认关闭自助注册，账号由管理员创建
ALLOW_SELF_REGISTER=false

# ====== 检索（可选） ======
# 开启 Cross-Encoder 精排：首次需下载约 2GB 模型，CPU 单次约 1-2 秒
RERANK_ENABLED=false

# ====== 存储路径（Docker 中由 compose 覆盖） ======
# BIZ_DB_PATH=/app/db/biz_data.db
# UPLOAD_DIR=/app/data/uploads
