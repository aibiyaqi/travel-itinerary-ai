# ============================================
# AI旅行智能助手 — Docker 忽略文件
# ============================================

# ---- 环境变量（包含 API KEY） ----
.env

# ---- Python 缓存 ----
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# ---- 向量库 / 运行数据（运行时挂载卷） ----
chroma_db/
data/uploads/
data/*.pdf

# ---- 业务数据库与导出（运行时生成，不打包进镜像） ----
biz_data.db
chat_history.db
*.db
exports/

# ---- IDE 配置 ----
.vscode/
.idea/

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- 日志 ----
*.log

# ---- 开发文档（不需要部署到生产） ----
plans/
docs/
.github/
1独立环境搭建.md
面试问题大全.md
data/eval/
.secrets/
.pytest_tmp/
_sandbox_tmp/
.npm-cache/

# ---- 测试文件 ----
tests/

# ---- Git ----
.git/
.gitignore

# ---- Docker ----
Dockerfile
.dockerignore
docker-compose.yml

# ---- Nginx 反向代理配置（由 compose 挂载，不打包进应用镜像） ----
nginx/

# ---- 备份文件 ----
*.bak
